modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 22096
externalPort = 3000

[userenv]

[userenv.shared]
# VITE_SUPABASE_ANON_KEY / VITE_SUPABASE_URL previously lived here pointed
# at hosted supabase.com — removed as part of the Logto + self-hosted data
# layer migration (see /infra/README.md for the replacement env vars, set
# per-environment via artifacts/*/.env rather than committed here).
# NOTE: the removed VITE_SUPABASE_ANON_KEY value was actually a
# `service_role` JWT mislabeled as the anon key — full-access DB
# credentials that were committed to this repo. Rotate/revoke that key in
# the Supabase dashboard; removing it from this file does not undo the
# exposure.
VAPID_PUBLIC_KEY = "BOqQ90FAgwPFgwi7G9ziAket2P6XJo9NUpC_taKF3tQ7-2Bh_T_NLDVyUXmVDJ1WNYAzBmk1wxiknQrD0uzAC5g"
VAPID_PRIVATE_KEY = "U8Yxb3TCcg_FnfM9WT27I8zFid9ItY6TKPEp3a1EX5c"
VAPID_CONTACT = "mailto:admin@buddiesworldwide.app"
VITE_VAPID_PUBLIC_KEY = "BOqQ90FAgwPFgwi7G9ziAket2P6XJo9NUpC_taKF3tQ7-2Bh_T_NLDVyUXmVDJ1WNYAzBmk1wxiknQrD0uzAC5g"
