# See ../README.md for how to fill these in.

POSTGRES_PASSWORD=

# Shared secret Kong's key-auth plugin checks on the `apikey` header —
# not a JWT, just needs to match what's pasted into volumes/api/kong.yml.
ANON_KEY=
SERVICE_ROLE_KEY=

# Logto core service (not the :3002 admin console).
LOGTO_ENDPOINT=http://logto:3001

# The Logto API Resource indicator created in infra/logto's README step 1.2.
SUPABASE_RESOURCE=https://api.buddies.local
